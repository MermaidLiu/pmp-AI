# 复制为 backend/.env 后按需修改

# 本地开发推荐：SQLite，零额外服务
DATABASE_URL=sqlite:///./petct_research.db

# PostgreSQL：先执行 pip install -r requirements-postgres.txt，再启用下面一行（使用 psycopg 3，勿写 psycopg2）
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/petct_research

# —— ReachAPI 大模型中转（OpenAI 兼容）——
# 文档入口：https://reachapi.ai/zh · Base：https://direct.reachapi.ai/v1
REACHAPI_API_KEY=
REACHAPI_BASE_URL=https://direct.reachapi.ai/v1
REACHAPI_CHAT_MODEL=gpt-5.6-sol

# —— DeepSeek 官方（与 ReachAPI 分开，可在智能对话/分析中切换）——
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://direct.reachapi.ai/v1
RESEARCH_LLM_MODEL=gpt-5.6-sol

# —— PMP 垂类模型（OpenAI 兼容；不填则使用本地规则+版本化指南证据）——
# 仅发送去标识化的临床/检验/影像摘要；不要把原始 DICOM、姓名或病历号发送到公网模型。
PMP_MODEL_API_KEY=
PMP_MODEL_BASE_URL=
PMP_MODEL_NAME=
PMP_MODEL_TIMEOUT=90

# —— ToolUniverse AI4S 科研工具层 ——
# ToolUniverse 只接收疾病/分级/基因等去标识化检索词，供文献、靶点、通路与组学研究编排。
TOOLUNIVERSE_ENABLED=true
TOOLUNIVERSE_LITERATURE_TOOL=Tool_Finder_Keyword

# 院方演示：设为 true 时科研接口永远不调用大模型，只返回内置模拟报告
DEMO_MODE=false

PETCT_MODEL_PATH=models/petct_seg_model.pth

# 公网部署时填写你的站点来源（逗号分隔），与浏览器地址栏协议+域名一致，例如：
# CORS_ORIGINS=https://petct.example.com,https://www.petct.example.com

# DICOM 影像诊断分析接口（POST multipart）
# curl -X POST http://42.81.102.195:8000/ct-module/dicom/upload \
#   -F "files=@CT001.dcm" -F "files=@study.zip" -F "runPci=true" -F "returnBase64=true"
PATHOLOGY_IMAGING_API_URL=http://42.81.102.195:8000/ct-module/dicom/upload
# 影像诊断分析约需 5–12 分钟（501 层 + PCI），读取超时建议 ≥720 秒
PATHOLOGY_IMAGING_API_TIMEOUT=720
# 标注 PNG 可视化需要 returnBase64=true（默认开启）
PATHOLOGY_IMAGING_RETURN_BASE64_DEFAULT=true
# 远端 CT 服务内存不足时可设为 120；0 表示不预抽样（失败时仍会自动降采样重试）
PATHOLOGY_IMAGING_MAX_DICOM_FILES=0
# 502/503/504 或超时时的单策略重试次数（每次请求内）
PATHOLOGY_IMAGING_RETRY_COUNT=3
# 超过 2 层 DICOM 时打包为单个 ZIP 再上传（多数 CT 服务不支持，保持 0）
PATHOLOGY_IMAGING_ZIP_THRESHOLD=0

# 相同 ZIP/DICOM 再次上传时命中磁盘缓存（秒级返回）
PATHOLOGY_GRADE_CACHE_ENABLED=true
PCI_API_URL=http://42.81.102.195:8509/genpci
PCI_API_TIMEOUT=300
PCI_ENABLED=true
# 默认 true：分割完成后按 sessionId / ZIP 文件名猜测 dcm_path 并轮询 genpci
PCI_PATH_GUESS=true
# 分割完成后轮询 genpci（等待 DICOM 落盘），间隔秒数 × 最大次数 ≈ 最长等待时间
PCI_POLL_INTERVAL_SECONDS=10
PCI_POLL_MAX_ATTEMPTS=0
# CT 模块未返回 dcm_path 时，用 sessionId 拼路径（需与 CT 落盘规则一致）
PCI_DCM_PATH_TEMPLATE=/mc/opt/PMPPredict/temp_data/dcm_uploads/{session_id}

# —— 会员与额度 ——
# 免费：10 次模型调用（简短问答，不计长上下文）；PRO：$199/月
AUTH_SECRET=pmp-dev-auth-secret-change-me
FREE_LLM_QUOTA=10
PRO_PRICE_USD=199
PRO_DURATION_DAYS=30
BILLING_MERCHANT_NAME=Hong Kong LingX Medical Tech Ltd
